FORESTGUARD_APP_NAME=ForestGuard
FORESTGUARD_ENVIRONMENT=development
FORESTGUARD_DATABASE_PATH=data/forestguard.sqlite3
FORESTGUARD_CORS_ORIGINS=["http://localhost:5173"]
FORESTGUARD_TELEGRAM_ENABLED=false
# Optional: configure locally in the ignored .env file. Never commit real credentials.
FORESTGUARD_TELEGRAM_BOT_TOKEN=
FORESTGUARD_TELEGRAM_CHAT_ID=
FORESTGUARD_TELEGRAM_MIN_SEVERITY=WARNING
FORESTGUARD_TELEGRAM_TIMEOUT_SECONDS=5
FORESTGUARD_TELEGRAM_RETRIES=2
# Device commands are inert records in this phase; real command creation is disabled by default.
FORESTGUARD_DEVICE_COMMANDS_ENABLED=false
FORESTGUARD_DEVICE_COMMANDS_AUTH_TOKEN=
FORESTGUARD_DEVICE_COMMANDS_OPERATOR_ID=configured_operator
FORESTGUARD_DEVICE_COMMAND_RATE_LIMIT=10
FORESTGUARD_DEVICE_COMMAND_RATE_WINDOW_SECONDS=60
FORESTGUARD_DEVICE_COMMAND_MAX_EXPIRY_SECONDS=3600
